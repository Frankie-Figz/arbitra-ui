# Local examples only. Never commit production credentials.
ARBITRA_RUNTIME_SNAPSHOT_PATH=./work/arbitra-snapshot.json
ARBITRA_UI_INGEST_TOKEN=replace-with-a-random-ingest-secret

# Elijah's Ravens platform ledger. The browser administrator and worker use
# different secrets. The worker token is shared only between Railway services.
ARBITRA_DATA_JOBS_ROOT=./work/data-jobs
ARBITRA_PLATFORM_JOB_TOKEN=replace-with-a-random-admin-secret
ARBITRA_DATA_WORKER_TOKEN=replace-with-a-different-random-worker-secret

# Great Data Oasis catalog and fenced job ledger. On Railway, bind this to the
# private PostgreSQL service through a service-variable reference.
ARBITRA_DATABASE_URL=postgresql://oasis_app:replace-me@127.0.0.1:5432/arbitra_oasis
# A separate connection granted oasis_ingest. Required whenever the API login
# above is correctly scoped to oasis_api only, because the worker claim,
# heartbeat and completion functions are granted to oasis_ingest. If omitted the
# API connection is reused, which only works for a combined-role local setup.
# Startup fails closed if the resulting worker connection lacks EXECUTE.
ARBITRA_INGEST_DATABASE_URL=postgresql://oasis_worker:replace-me@127.0.0.1:5432/arbitra_oasis

# Railway Bucket credentials. On Railway, map these from the bucket's
# BUCKET, ENDPOINT, REGION, ACCESS_KEY_ID and SECRET_ACCESS_KEY variables.
BUCKET_NAME=arbitra-history-example
BUCKET_ENDPOINT=https://storage.railway.app
BUCKET_REGION=auto
BUCKET_ACCESS_KEY_ID=replace-me
BUCKET_SECRET_ACCESS_KEY=replace-me
# Set true only for a legacy bucket whose Credentials tab requires path style.
BUCKET_FORCE_PATH_STYLE=false
